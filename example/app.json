{
  "expo": {
    "name": "SmoothClipView Example",
    "slug": "react-native-smooth-clip-view-example",
    "version": "1.0.0",
    "scheme": "smoothclipviewexample",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "smoothclipview.example"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "smoothclipview.example"
    },
    "plugins": [
      "./plugins/withSmoothClipTestPods.js",
      "expo-image"
    ]
  }
}
